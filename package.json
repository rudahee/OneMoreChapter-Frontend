{
  "name": "uncapitulomas",
  "version": "0.0.1",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:mobile": "ng build --configuration production && npx cap sync",
    "android": "npm run build:mobile && npx cap open android",
    "apk": "npm run build:mobile && cd android && gradlew assembleDebug",
    "apk:unix": "npm run build:mobile && cd android && ./gradlew assembleDebug"
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.1",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@stomp/stompjs": "^7.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@capacitor/cli": "^8.5.1",
    "typescript": "~6.0.0"
  }
}
